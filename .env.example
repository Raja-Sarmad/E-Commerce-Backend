# ─────────────────────────────────────────────────────────────
#  NovaMart Backend — Environment Variables
#  Copy this file to `.env` and fill in real values.
#  NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# --- Server ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
API_PREFIX=/api/v1

# --- Database (MongoDB) ---
# Local:  mongodb://127.0.0.1:27017/novamart
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/novamart
MONGO_URI=mongodb://127.0.0.1:27017/novamart

# --- Auth (JWT) ---
# Generate with: node --input-type=module -e "import { randomBytes } from 'crypto'; console.log(randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_64_char_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Access token cookie name (default: access_token)
# Refresh token cookie name (default: refresh_token)

# --- Email (Nodemailer) ---
# Use a dev sink like Ethereal (https://ethereal.email) or a real SMTP provider.
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="NovaMart <no-reply@novamart.com>"
# Frontend reset/verify link base URL
FRONTEND_URL=http://localhost:3000

# --- Cloudinary ---
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=novamart
CLOUDINARY_UPLOAD_TIMEOUT_MS=120000
CLOUDINARY_UPLOAD_RETRIES=2
# Keep false when product images must be stored on Cloudinary.
CLOUDINARY_FALLBACK_TO_LOCAL=false

# --- Admin (created by seed script) ---
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@novamart.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_PHONE=+1 555 010 0000

# --- Rate Limiting (requests per window) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# --- Misc ---
LOG_LEVEL=dev
MAX_IMAGE_UPLOAD_MB=5
